PORT=3000
NODE_ENV=production

DB_URL=mongodb+srv://user:password@cluster.mongodb.net/talent-iq
CLIENT_URL=https://your-frontend.vercel.app

# Google OAuth (same Client ID as the frontend, from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT signing secret for our app's session token (any long random string)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Piston code-execution API. Required for "Run Code": the public emkc.org
# instance is whitelist-only since 2026-02-15, so host your own.
# See https://github.com/engineer-man/piston#self-hosting
PISTON_URL=http://localhost:2000/api/v2

STREAM_API_KEY=your_stream_key
STREAM_API_SECRET=your_stream_secret

SUPER_ADMIN_EMAIL=you@example.com

# Optional – email notifications via nodemailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@example.com
